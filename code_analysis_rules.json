{
  "log_level": "all",
  "max_lines_per_file": {
    "enabled": true,
    "warning": 300,
    "error": 500,
    "exclude_patterns": [".git/**", "**/.dart_tool/**", "**/build/**"]
  },
  "pmd_duplicates": {
    "enabled": true,
    "minimum_tokens": 100,
    "exclude_patterns": {
      "dart": ["*.g.dart", "*.freezed.dart", "*.mocks.dart", "*.gr.dart"]
    }
  },
  "dart_analyze": {
    "enabled": true
  },
  "dart_code_linter": {
    "enabled": true,
    "auto_install": true,
    "analyze_path": "lib",
    "keep_report": false,
    "metrics": {
      "cyclomatic-complexity": {
        "warning": 10,
        "error": 15
      }
    }
  },
  "flutter_analyze": {
    "enabled": false,
    "exclude_patterns": ["*.g.dart", "*.freezed.dart"]
  }
}
